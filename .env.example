# API-ключ для сервиса курсов валют
# Получите на https://apilayer.com/account/plan
# Пример: sk_prod_abc123xyz789
API_KEY=your-secret-api-key-here

# Базовый URL API (без endpoint)
# Не изменяйте, если не используете другой провайдер
API_BASE_URL=https://api.apilayer.com/exchangerates_data

# Endpoint для конвертации:
# /convert — возвращает готовый результат (result), если передать сумму (amount)
# /latest — возвращает курсы валют (rates), тогда конвертацию нужно делать вручную: amount * rate
# Рекомендуется использовать /convert для простоты
API_ENDPOINT=/convert

# Режим отладки
# True — подробные логи, False — минимум логов
DEBUG=False


# Уровень логирования
# Варианты: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
